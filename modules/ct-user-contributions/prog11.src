STO
 10 ; DDD.MMmmmmm
INT ; DDD
STO
 00 ; DDD
 (
RCL
 10 ; DDD.MMmmmmm
INV
INT ; .MMmmmmm
 /
 .
 6
 )  ; .ddddddd
SUM
 00 ; DDD.ddddddd
RCL
 00 ; DDD.ddddddd
RTN

 ; 029 absolute address, convert from decimal DDD.ddddddd to DDDMM.mmmmm

LBL ; convert to cockpit format
+/-
